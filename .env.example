# Copy this file to .env.local only after the matching service is connected.
# Never commit real values. Vercel stores production values in Project Settings.

# App
NEXT_PUBLIC_APP_URL=https://draftflow-beta-dashboard.vercel.app

# Authentication (Clerk or equivalent managed provider)
NEXT_PUBLIC_AUTH_PUBLISHABLE_KEY=
AUTH_SECRET=

# Database (Neon Postgres or equivalent)
DATABASE_URL=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# Google OAuth — only when the Drive connection feature is ready
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok OAuth — only after TikTok approves public production access
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Encrypt OAuth token records at rest; do not reuse an app/client secret here.
TOKEN_ENCRYPTION_KEY=

